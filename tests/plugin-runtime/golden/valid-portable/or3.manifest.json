  "dependencies": {
    "required": [],
    "optional": []
  },
  "trust": "isolated-client",
  "settings": {
    "version": 1,
    "schema": "settings.schema.json"
  },
  "stateCompatibility": {
    "version": 0,
    "reads": {
      "minimum": 0,
      "maximum": 0
    },
    "rollback": "safe"
  },
  "integrity": {
    "package": "sha256-13b0a4d83dc8a2724c277474dc27d3496882e8c2de7d2d7c6cd7e882a41968ba"
