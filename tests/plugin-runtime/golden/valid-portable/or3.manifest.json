{
  "manifestVersion": 2,
  "kind": "plugin",
  "id": "or3.golden-portable",
  "name": "Golden Portable Fixture",
  "version": "1.0.0",
  "engines": {
    "or3": "^0.3.0",
    "pluginApi": "^2.0.0"
  },
  "runtime": {
