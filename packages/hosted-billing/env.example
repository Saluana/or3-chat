# Build-time opt-in. Leave unset for every ordinary build.
OR3_HOSTED_BILLING_ENABLED=true

# Existing host requirements:
SSR_AUTH_ENABLED=true
OR3_AUTH_PROVIDER=basic-auth
OR3_SYNC_PROVIDER=sqlite
OR3_GUEST_ACCESS_ENABLED=false
OR3_SQLITE_DRIVER=better-sqlite3
OR3_SQLITE_DB_PATH=/data/sync.sqlite

# Private runtime settings. Fill these in an ignored deployment env file.
# Prefer a restricted Stripe sandbox key while qualifying the integration.
OR3_BILLING_STRIPE_SECRET_KEY=
OR3_BILLING_STRIPE_WEBHOOK_SECRET=
OR3_BILLING_STRIPE_PRICE_ID=
OR3_BILLING_BASE_URL=https://your-host.example
OR3_BILLING_SQLITE_PATH=/data/billing.sqlite
