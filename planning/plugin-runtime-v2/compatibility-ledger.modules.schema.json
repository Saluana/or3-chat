{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://or3.dev/schemas/plugin-runtime-v2-compatibility-ledger-modules.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nuxtImportsDeclaration", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "nuxtImportsDeclaration": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "runtime", "publicPaths", "docs"],
        "properties": {
          "source": { "type": "string", "pattern": "\\.tsx?$" },
          "runtime": { "enum": ["client", "server", "shared"] },
          "publicPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "docs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
