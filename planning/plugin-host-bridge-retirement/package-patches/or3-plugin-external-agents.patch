+import { computed, defineComponent, onMounted, ref, shallowRef } from 'vue';
+import type { PluginContext, PluginResult } from '@or3/plugin-sdk';
+import type { AgentHostUiPort } from './host-ui';
+import { createAgentStagingTransport } from './staging';
+import { createMediatedAgentFetch } from './mediated-fetch';
+
+const ClientOnly = defineComponent({ setup(_props, { slots }) { const mounted = ref(false); onMounted(() => { mounted.value = true; }); return () => mounted.value ? slots.default?.() : slots.fallback?.(); } });
+function value<T>(result: PluginResult<T>): T { if (!result.ok) throw new Error(result.error.message); return result.value; }
+
+export async function createAgentSdkAdapter(context: PluginContext) {
+    context.features.require('or3-trusted-ui-kit-v1'); context.features.require('or3-trusted-host-v2');
+    const kit = context.ui.kit; if (!kit) throw new Error('Trusted UI kit unavailable');
+    const limits = value(await context.files.limits());
+    const status = await context.workspace.connections.status();
+    const panes = shallowRef<readonly { id: string; mode: string; documentId?: string }[]>([]); const activeIndex = ref(0);
+    const applyPanes = (items: readonly { id: string; app: string; recordId?: string; active: boolean }[]) => { panes.value = items.map(item => ({ id: item.id, mode: item.app, documentId: item.recordId })); activeIndex.value = Math.max(0, items.findIndex(item => item.active)); };
+    applyPanes(value(await context.panes.list()));
+    context.panes.onChange(applyPanes);
+    const toast = (input: { title: string; description?: string; color?: string }) => { context.ui.toast({ message: input.title, description: input.description, tone: input.color === 'error' ? 'danger' : input.color === 'warning' ? 'warning' : 'info' }); };
+    let vault = value(await context.secrets.get('vault'));
+    let pending = Promise.resolve();
+    const saveVault = (next: string | null) => { vault = next; pending = pending.then(async () => { const result = next === null ? await context.secrets.delete('vault') : await context.secrets.set('vault', next); if (!result.ok) toast({ title: 'Credential storage failed', description: result.error.message, color: 'error' }); }); };
+    const ui: AgentHostUiPort = {
+        components: { ...kit.components, chatComposerShell: kit.components.ChatComposerShell, chatMessage: kit.components.ChatMessage, scroll: kit.components.Scroll, ClientOnly },
+        activeTheme: kit.theme.active, icon: kit.icon, chatInputTheme: kit.chatInputTheme, limits, toast,
+        connect: { enabled: status.ok && status.value.enabled, publicUrl: status.ok ? status.value.pairingUrl : undefined, async removeEnvironment(id) { const result = await context.workspace.connections.remove(id); return new Response(null, { status: result.ok ? 200 : 400 }); } },
+        setActiveSidebarPage: async id => { value(await context.ui.sidebar.show(id)); }, closeSidebarIfMobile: () => { value(context.ui.sidebar.closeIfMobile()); },
+        panes: { items: panes, activeIndex,
+            async set(index, appId, recordId) { const pane = panes.value[index]; if (!pane) throw new Error('Pane unavailable'); value(await context.panes.open({ app: appId, data: { recordId }, target: { pane: pane.id } })); },
+            async open(appId, recordId) { value(await context.panes.open({ app: appId, data: { recordId }, target: 'new' })); },
+        },
+    };
+    const raw = value(await context.storage.get('connections'));
+    if (typeof raw === 'string') {
+        let data: { hosts?: Array<{ baseUrl: string }> } = {};
+        try { data = JSON.parse(raw); } catch { /* The persistence parser retains corrupt source bytes. */ }
+        const origins = [...new Set((Array.isArray(data?.hosts) ? data.hosts : []).flatMap(host => {
+            try { return [new URL(host.baseUrl).origin]; } catch { return []; }
+        }))];
+        if (origins.length) value(await context.network.requestAccess({ origins, purpose: 'Reconnect your saved agent hosts after upgrading.' }));
+    }
+    return {
+        ui,
+        workspaceKv: {
+            async get(workspaceId: string, _key: string) { if (workspaceId !== context.workspace.id) throw new Error('Workspace changed'); const result = value(await context.storage.get('connections')); return typeof result === 'string' ? result : null; },
+            async set(workspaceId: string, _key: string, data: string) { if (workspaceId !== context.workspace.id) throw new Error('Workspace changed'); value(await context.storage.set('connections', data)); },
+        },
+        vaultStorage: { getItem: () => vault, setItem: (_key: string, data: string) => saveVault(data), removeItem: () => saveVault(null) },
+        staging: createAgentStagingTransport(createMediatedAgentFetch(context)),
+        async beginHostVerification(baseUrl: string) { const origin = new URL(baseUrl).origin; const result = value(await context.network.requestAccess({ origins: [origin], purpose: 'Verify and connect the agent host you selected.' })); if (!result.approved.includes(origin)) throw new Error('Agent host access was declined'); return () => {}; },
+        registerCodingProfile: (profile: unknown) => context.ui.registerWorkspaceProfile(profile),
+    };
+}
