{
    "name": "or3-chat",
    "type": "module",
    "private": false,
    "version": "0.1.0",
    "license": "GPL-3.0",
    "scripts": {
        "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build && bun run scripts/plugin-runtime/check-production-build.ts --mode ssr",
        "start": "bun run scripts/cli/start.ts",
        "dev": "bun run scripts/cli/dev.ts",
        "dev:ssr": "SSR_AUTH_ENABLED=true HOST=127.0.0.1 bun run dev -- --host 127.0.0.1 --port 3000",
        "convex-dev": "bunx convex dev",
        "generate": "nuxt generate",
        "generate:static": "SSR_AUTH_ENABLED=false nuxt generate && bun run scripts/plugin-runtime/check-production-build.ts --mode static",
        "preview": "nuxt preview",
        "preview:static": "bunx serve .output/public -l 4173",
        "postinstall": "nuxt prepare",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e:scroll": "OR3_SCROLL_TEST_HARNESS=true PW_PORT=3107 bunx playwright test tests/e2e/or3-scroll-canary.spec.ts",
        "analyze": "bun run build && npx vite-bundle-visualizer dist/stats.html",
        "eslint": "eslint",
        "lint": "echo 'Lint script would go here'",
        "type-check": "SSR_AUTH_ENABLED=true nuxt typecheck",
        "check-imports": "bash scripts/check-banned-imports.sh",
        "theme:validate": "tsx scripts/cli/validate-theme.ts",
        "theme:create": "tsx scripts/cli/create-theme.ts",
        "theme:switch": "tsx scripts/cli/switch-theme.ts",
        "theme:build-css": "tsx scripts/build-theme-css.ts",
        "sandbox:fresh": "bun run scripts/cli/create-temp-sandbox.ts",
        "or3-cloud": "bun run scripts/cli/or3-cloud.ts",
        "or3-cloud:init": "bun run scripts/cli/or3-cloud.ts init",
        "or3-cloud:validate": "bun run scripts/cli/or3-cloud.ts validate",
        "or3-cloud:doctor": "bun run scripts/cli/or3-cloud.ts doctor",
        "or3-cloud:build": "bun build ./scripts/cli/or3-cloud.ts --target=node --format=esm --outfile ./dist/or3-cloud.mjs",
        "plugin-runtime:ledger": "bun run scripts/plugin-runtime/generate-compatibility-ledger.ts",
        "plugin-runtime:ledger:check": "bun run scripts/plugin-runtime/generate-compatibility-ledger.ts --check",
        "plugin-runtime:snapshots": "bun run scripts/plugin-runtime/generate-compatibility-snapshots.ts",
        "plugin-runtime:snapshots:check": "bun run scripts/plugin-runtime/generate-compatibility-snapshots.ts --check",
        "plugin-runtime:compatibility:check": "bun run plugin-runtime:ledger:check && bun run plugin-runtime:snapshots:check",
        "plugin-runtime:examples:check": "bun run scripts/plugin-runtime/check-example-fixtures.ts && bunx vitest run scripts/__tests__/plugin-runtime-example-fixtures.test.ts",
        "plugin-runtime:external-v1:check": "bun run scripts/plugin-runtime/check-example-fixtures.ts tests/plugin-runtime/external-v1/tsconfig.json",
        "plugin-runtime:benchmarks": "bunx vite-node --config vitest.config.ts --mode production scripts/plugin-runtime/benchmark-v1.ts --report",
        "plugin-runtime:benchmarks:check": "bunx vite-node --config vitest.config.ts --mode production scripts/plugin-runtime/benchmark-v1.ts --check",
        "plugin-runtime:hooks-v2:benchmarks:check": "bunx vite-node --config vitest.config.ts --mode production scripts/plugin-runtime/benchmark-v1.ts --v2 --check",
        "plugin-runtime:benchmarks:record": "bunx vite-node --config vitest.config.ts --mode production scripts/plugin-runtime/benchmark-v1.ts --record",
        "plugin-runtime:milestone-0:qualify": "bun run scripts/plugin-runtime/qualify-milestone-0.ts",
        "plugin-runtime:milestone-0:record": "bun run scripts/plugin-runtime/qualify-milestone-0.ts --record",
        "plugin-runtime:milestone-1:qualify": "bun run scripts/plugin-runtime/qualify-milestone-1.ts",
        "plugin-runtime:milestone-1:record": "bun run scripts/plugin-runtime/qualify-milestone-1.ts --record",
        "plugin-runtime:milestone-2-3:qualify": "bun run scripts/plugin-runtime/qualify-milestone-2-3.ts",
        "plugin-runtime:milestone-2-3:record": "bun run scripts/plugin-runtime/qualify-milestone-2-3.ts --record",
        "plugin-runtime:milestone-4:qualify": "bun run scripts/plugin-runtime/qualify-milestone-4.ts",
        "plugin-runtime:milestone-4:record": "bun run scripts/plugin-runtime/qualify-milestone-4.ts --record",
        "plugin-runtime:milestone-5:qualify": "bun run scripts/plugin-runtime/qualify-milestone-5.ts",
        "plugin-runtime:milestone-5:record": "bun run scripts/plugin-runtime/qualify-milestone-5.ts --record",
        "plugin-runtime:milestone-9:qualify": "bun run scripts/plugin-runtime/qualify-milestone-9.ts",
        "plugin-runtime:milestone-9:record": "bun run scripts/plugin-runtime/qualify-milestone-9.ts --record",
        "plugin-runtime:cli": "bun run scripts/plugin-runtime/cli/index.ts",
        "plugin-runtime:v1-imports:warn": "bun run scripts/plugin-runtime/codemod-v1-private-imports.ts",
        "plugin-runtime:contracts:check": "bun x tsc --project tests/plugin-runtime/contracts/tsconfig.json",
        "plugin-runtime:sdk:check": "bun x tsc --project packages/plugin-sdk/tsconfig.json && bun x tsc --project tests/plugin-runtime/sdk-minimal/tsconfig.json",
        "plugin-runtime:v2-conformance:check": "bun run scripts/plugin-runtime/check-v2-package-conformance.ts tests/plugin-runtime/v2-conformance/valid && bun x vitest run scripts/__tests__/plugin-runtime-v2-conformance.test.ts",
        "plugin-runtime:first-party-v2:check": "bun run scripts/plugin-runtime/check-v2-package-conformance.ts examples/plugins/dashboard-insights-v2 && bun x vitest run tests/unit/plugin-sdk-first-party-v2.test.ts tests/unit/plugin-sdk-test-harness.test.ts",
        "plugin-runtime:host-esm-facade:check": "bun run scripts/plugin-runtime/check-host-esm-facade.ts && bun x vitest run shared/plugins/__tests__/host-esm-facade.test.ts scripts/__tests__/plugin-runtime-host-esm-facade.test.ts",
        "plugin-runtime:package-tree:check": "bun x vitest run server/admin/plugins/__tests__/package-tree.test.ts server/admin/plugins/__tests__/package-store.test.ts",
        "plugin-runtime:package-lock:check": "bun x vitest run server/admin/plugins/__tests__/package-operation-lock.test.ts server/admin/plugins/__tests__/package-operation-lock-process.test.ts server/admin/plugins/__tests__/package-store.test.ts",
        "plugin-runtime:package-pointer:check": "bun x vitest run server/admin/plugins/__tests__/package-pointer-store.test.ts server/admin/plugins/__tests__/package-store.test.ts server/admin/plugins/__tests__/package-tree.test.ts",
        "plugin-runtime:package-candidate:check": "bun x vitest run server/admin/plugins/__tests__/package-candidate.test.ts server/admin/plugins/__tests__/package-pointer-store.test.ts server/admin/plugins/__tests__/package-store.test.ts",
        "plugin-runtime:package-canary:check": "bun x vitest run server/admin/plugins/__tests__/package-candidate-canary.test.ts server/admin/plugins/__tests__/package-candidate.test.ts",
        "plugin-runtime:package-assets:check": "bun x vitest run server/admin/plugins/__tests__/package-assets.test.ts",
        "plugin-runtime:module-v2-loader:check": "bun x vitest run shared/plugins/__tests__/module-v2-loader.test.ts shared/plugins/__tests__/module-loader-v2-status.test.ts shared/plugins/__tests__/route-permissions.test.ts",
        "plugin-runtime:server-module-resolver:check": "bun x vitest run server/admin/plugins/__tests__/server-module-resolver.test.ts server/api/plugins/__tests__/dispatcher.test.ts",
        "plugin-runtime:package-promotion:check": "bun x vitest run server/admin/plugins/__tests__/package-promotion.test.ts server/admin/plugins/__tests__/settings-migration.test.ts server/admin/plugins/__tests__/package-lifecycle.test.ts server/admin/plugins/__tests__/package-promotion-e2e.test.ts",
        "plugin-runtime:isolation:check": "bun x vitest run shared/plugins/isolation/__tests__ server/admin/plugins/isolation/__tests__",
        "plugin-runtime:runtime-controls:check": "bun x vitest run shared/plugins/__tests__/runtime-controls.test.ts",
        "plugin-runtime:cli:check": "bun x vitest run scripts/__tests__/plugin-runtime-cli.test.ts scripts/__tests__/plugin-runtime-v1-codemod.test.ts",
        "dev:offline": "env SSR_AUTH_ENABLED=false OR3_SYNC_ENABLED=false OR3_CLOUD_SYNC_ENABLED=false OR3_STORAGE_ENABLED=false OR3_CLOUD_STORAGE_ENABLED=false OR3_BACKGROUND_STREAMING_ENABLED=false bun run dev"
    },
    "bin": {
        "or3-cloud": "./bin/or3-cloud.js"
    },
    "dependencies": {
        "@nuxt/ui": "4.10.0",
        "@openrouter/sdk": "^1.0.0",
        "@or3/plugin-sdk": "file:./packages/plugin-sdk",
        "@orama/orama": "^3.1.16",
        "@tiptap/core": "^3.28.0",
        "@tiptap/extension-image": "^3.28.0",
        "@tiptap/extension-list": "^3.28.0",
        "@tiptap/extension-mention": "^3.28.0",
        "@tiptap/extension-table": "^3.28.0",
        "@tiptap/extensions": "^3.28.0",
        "@tiptap/pm": "^3.28.0",
        "@tiptap/starter-kit": "^3.28.0",
        "@tiptap/suggestion": "^3.28.0",
        "@tiptap/vue-3": "^3.28.0",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "14.3.0",
        "ajv": "^8.20.0",
        "bcryptjs": "^3.0.3",
        "dexie": "~4.3.0",
        "dexie-export-import": "^4.1.4",
        "gpt-tokenizer": "^3.4.0",
        "jsonwebtoken": "^9.0.3",
        "lru-cache": "^11.5.2",
        "nuxt": "4.5.0",
        "or3-provider-basic-auth": "file:../or3-provider-basic-auth",
        "or3-provider-clerk": "file:../or3-provider-clerk",
        "or3-provider-convex": "file:../or3-provider-convex",
        "or3-provider-fs": "file:../or3-provider-fs",
        "or3-provider-s3": "file:../or3-provider-s3",
        "or3-provider-sqlite": "file:../or3-provider-sqlite",
        "or3-scroll": "0.0.3",
        "or3-workflow-core": "^0.1.2",
        "or3-workflow-vue": "^0.1.4",
        "semver": "^7.8.5",
        "spark-md5": "^3.0.2",
        "streamdown-vue": "1.0.29",
        "streamsaver": "^2.0.6",
        "tiptap-markdown": "^0.9.0",
        "virtua": "^0.41.5",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@iconify-json/carbon": "^1.2.19",
        "@iconify-json/lucide": "^1.2.118",
        "@iconify-json/pixelarticons": "^1.2.4",
        "@iconify-json/tabler": "^1.2.33",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/typography": "^0.5.19",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "@types/semver": "^7.7.1",
        "@types/spark-md5": "^3.0.5",
        "@types/streamsaver": "^2.0.5",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vitejs/plugin-vue": "6.0.8",
        "@vitest/coverage-v8": "4.1.10",
        "@vue/test-utils": "^2.4.11",
        "better-sqlite3": "^12.11.1",
        "convex": "1.32.0",
        "eslint": "^9.39.1",
        "fake-indexeddb": "^5.0.2",
        "jsdom": "^25.0.1",
        "tailwindcss": "4.3.3",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "vite": "8.1.5",
        "vite-bundle-visualizer": "^1.2.1",
        "vitest": "4.1.10"
    },
    "overrides": {
        "prosemirror-model": "1.25.11",
        "prosemirror-transform": "1.12.0",
        "prosemirror-view": "1.42.1",
        "vite-plugin-pwa": "1.3.0",
        "vue": "3.5.40"
    },
    "trustedDependencies": [
        "@parcel/watcher",
        "better-sqlite3"
    ]
}
